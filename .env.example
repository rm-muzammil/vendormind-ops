# Copy to .env.local and fill in. Never commit .env.local.
VULTR_API_KEY=REPLACE_ME
VULTR_BASE_URL=https://api.vultrinference.com/v1
# Pick a model id from GET /v1/models. A non-reasoning instruct model is much faster.
VULTR_MODEL=llama-3.1-70b-instruct
VULTR_MAX_TOKENS=8000
# Orders above this value always need a human approval
APPROVAL_THRESHOLD=10000
# How long vendors have to answer an RFQ, and how often the background scheduler runs
QUOTE_WINDOW_HOURS=48
SCHEDULER_SECONDS=60
